PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# --- Supabase (Dashboard > Project Settings > API Keys) ---
SUPABASE_URL=https://your-project.supabase.co
# Publishable (anon) key: used ONLY for sign-in / sign-up calls.
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Secret (service-role) key: backend only. Used for Storage + Auth admin. NEVER put it in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Database (Dashboard > Connect > "Session pooler" connection string) ---
# Use the SESSION POOLER string (IPv4-compatible), and put your database password in it.
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Secret used to sign the backend's login tokens. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Must be false once Supabase is connected (true = in-memory demo accounts).
DEMO_LOGIN=false

# --- Email (only needed for password-reset emails) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-email@gmail.com
